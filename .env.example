# Copy to .env (or export in your shell). All keys are optional: with none set,
# the built-in "mock" provider is used so the app still runs end-to-end.

PORT=3000

# Rooms and transcripts are saved to $DATA_DIR/rooms.json and restored on restart.
# Set PERSIST=0 to keep everything in memory only.
DATA_DIR=./data
PERSIST=1

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# OpenRouter (hundreds of models behind one OpenAI-compatible API)
OPENROUTER_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Ollama / LM Studio / any local OpenAI-compatible server (no key needed)
OLLAMA_BASE_URL=http://localhost:11434/v1
